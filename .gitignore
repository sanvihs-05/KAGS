# Virtual environments
venv/
.venv/
env/
.env/
# Local secrets. NOTE: the pattern above ends in a slash so it only matches a
# DIRECTORY named .env — a .env *file* holding an API key would have been
# committed. Both forms are ignored now.
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo

# Node
node_modules/

# Large embedding / vector-store / index artifacts (regenerable)
*.npy
*.pkl
*.bin
*.index
enhanced_multimodal_rag_store/
# Generated by embeddings_generator/build_cubicasa_rag.py (regenerable, ~45 MB)
cubicasa_rag_store/
# Raw CubiCasa5K dataset (large; not source)
cubicasa5k/
data/faiss_index/

# Corrupted / scratch
*.corrupted

# Pipeline run outputs (regenerated by every run; not source)
outputs/*
!outputs/.gitkeep
visual_outputs/*
!visual_outputs/.gitkeep
pipeline_outputs/*
!pipeline_outputs/.gitkeep
demo_outputs/
hierarchical_outputs/

# OS files
.DS_Store
Thumbs.db

# Result store (regenerated by runs; not source)
results/

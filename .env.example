# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
#
# Without a reachable LLM the encoder falls back to a rule-based parser that
# always succeeds but returns a GENERIC room programme — generic room names and
# none of the brief's specifics. The UI now flags this, but setting the key is
# what actually fixes it.
GROQ_API_KEY=gsk_your_key_here

# Alternatives (any OpenAI-compatible endpoint):
# KAGS_LLM_API_KEY=...
# KAGS_LLM_BASE_URL=https://api.openai.com/v1
# KAGS_LLM_MODEL=gpt-4o-mini
